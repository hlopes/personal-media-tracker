<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">
<module name="Checker">
  <property name="charset" value="UTF-8"/>
  <property name="severity" value="error"/>
  <property name="fileExtensions" value="java"/>

  <module name="TreeWalker">
    <!-- Forbid single-statement if without braces (already handled by palantir, but extra safety) -->
    <module name="NeedBraces"/>
  </module>

  <!-- Require blank line before return unless it's the only statement in the block (directly after {) -->
  <module name="RegexpMultiline">
    <property name="format" value="[^ \{\r\n]\r?\n[ \t]*return;"/>
    <property name="message" value="Add blank line before 'return'"/>
  </module>

  <!-- Require blank line before blocks unless it's the first statement directly after { -->
  <module name="RegexpMultiline">
    <property name="format" value="[^ \{\}\r\n]\r?\n[ \t]*(?:if|else|for|while|try|catch|finally|synchronized|do)\b[^\n]*\{"/>
    <property name="message" value="Add blank line before block"/>
  </module>

  <!-- Also check header if needed -->
</module>

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.java]
indent_style = space
indent_size = 2
continuation_indent_size = 4

[*.{yml,yaml,properties,xml,html,qute.html}]
indent_style = space
indent_size = 2

[*.{md,json}]
indent_style = space
indent_size = 2

[*.{sh,bat,ps1}]
end_of_line = lf
